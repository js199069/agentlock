#!/usr/bin/env php
<?php

declare(strict_types=1);

foreach ([__DIR__ . '/../vendor/autoload.php', __DIR__ . '/../../../autoload.php'] as $autoload) {
    if (is_file($autoload)) {
        require $autoload;
        break;
    }
}

use Js199069\Agentlock\Console\BaselineCommand;
use Js199069\Agentlock\Console\InstallHookCommand;
use Js199069\Agentlock\Console\LockCommand;
use Js199069\Agentlock\Console\ScanCommand;
use Js199069\Agentlock\Console\VerifyCommand;
use Symfony\Component\Console\Application;

$app = new Application('agentlock', '0.1.0');
$app->addCommands([new ScanCommand(), new LockCommand(), new VerifyCommand(), new BaselineCommand(), new InstallHookCommand()]);
$app->run();
